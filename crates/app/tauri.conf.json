{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OptimaX",
  "version": "0.1.0",
  "identifier": "com.x44to.optimax",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OptimaX by X44TO",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#090B12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "X44TO",
    "shortDescription": "Діагностика й оптимізація ігрових ПК",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "../../THIRD_PARTY_LICENSES": "THIRD_PARTY_LICENSES.txt" },
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Ukrainian", "English"]
      }
    }
  }
}
