{
  "name": "optimax-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:i18n": "node scripts/check-i18n.mjs",
    "tauri": "tauri",
